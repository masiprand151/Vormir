{
  "name": "@vormir/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild ../example/app.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=../dist/bundle.js --alias:@vormir/sdk=./src/index.ts",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
