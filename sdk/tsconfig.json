{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@vormir/sdk": ["src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts", "../example/**/*.ts"]
}
